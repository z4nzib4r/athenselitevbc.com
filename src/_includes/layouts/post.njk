---
layout: layouts/base.njk
---
<header class="page-header">
  <div class="container">
    <p class="eyebrow"><time datetime="{{ page.date.toISOString() }}">{{ page.date | readableDate }}</time></p>
    <h1>{{ title }}</h1>
  </div>
</header>
<article class="container content">
  {{ content | safe }}
</article>
